# DevAtlas Backend — copy to .env and fill in
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://devatlas:devatlas@localhost:5432/devatlas
REDIS_URL=redis://localhost:6379/0

# GitHub ingestion (PAT or GitHub App)
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_INSTALLATION_ID=

# AI providers (any one is enough)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Auth
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Email: console | smtp
EMAIL_SERVICE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=noreply@devatlas.local
